# x402 Resource Server Configuration — CERBERUS
# Copy this file to .env and fill in your values.

# ── Algorand TestNet receiver wallet address ───────────────────────────────────
# Generate at: https://lora.algokit.io/testnet  (or use any Algorand wallet)
AVM_ADDRESS=<your-algorand-testnet-wallet-address>

# ── x402 Facilitator (GoPlausible hosted) ─────────────────────────────────────
FACILITATOR_URL=https://facilitator.goplausible.xyz

# ── x402 Server Port ──────────────────────────────────────────────────────────
PORT=4021

# ── Python AI Backend URL (localhost only) ────────────────────────────────────
AI_BACKEND_URL=http://localhost:8000

# ── Internal proxy secret — REQUIRED ─────────────────────────────────────────
# Must match backend/.env. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# NO default — server refuses to start if unset.
INTERNAL_SECRET=

# ── CORS — allowed frontend origin ────────────────────────────────────────────
# '*' = allow any origin (OK for local dev, NOT for production)
# Production: set to your exact frontend URL, e.g. https://cerberus.yourapp.com
ALLOWED_ORIGIN=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum requests per IP per minute on the /analyze-contract endpoint.
RATE_LIMIT_RPM=10

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# DEMO_MODE=true  → DEMO_TXID is accepted without Algorand Indexer round-trip.
# Use ONLY for local presentations. NEVER enable in production.
# When enabled, set DEMO_TXID to a well-formed 52-char Algorand Testnet TxID.
DEMO_MODE=false
# DEMO_TXID=<52-char-base32-algorand-txid>
