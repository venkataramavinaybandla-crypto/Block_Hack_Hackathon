# x402 Resource Server Configuration
# Algorand TestNet - hosted GoPlausible facilitator

# Your resource server receiving address (for USDC payments)
# See: https://dev.algorand.co/concepts/accounts/create/
# Valid checksummed Algorand Testnet address for the CERBERUS demo:
AVM_ADDRESS=3LMI2BONQHGE6SCKLONQYJQCYIA5R32P5PEXLNXKUQS3CAMXRDDLBV342I

# Demo / instant-execution mode: the pre-filled demo TxID is accepted instantly
# (no indexer round-trip). Set DEMO_MODE=false to force strict on-chain checks
# for every TxID. DEMO_TXID is a well-formed 52-char base32 testnet TxID.
DEMO_MODE=true
DEMO_TXID=SIAKOLZAYLX3UZK5IL26SLDUDN523ZNSU65HF4CEYS4YOP5WDVKQ

# Hosted Facilitator URL (use GoPlausible by default)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server port
PORT=4021

# ── Required: internal secret shared with the Python AI backend ─────────────
# MUST be set (copy this file to .env and fill it in). No hardcoded default —
# the server refuses to start if unset. Must match backend/.env.
INTERNAL_SECRET=

# Python AI backend (binds to 127.0.0.1 only)
AI_BACKEND_URL=http://localhost:8000
