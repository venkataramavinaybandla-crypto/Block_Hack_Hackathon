# ── CERBERUS Python AI Backend (.env) ───────────────────────────────────────
# Copy this file to backend/.env and fill in the values.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Internal secret shared with the x402 Node gateway (x402-server/.env).
# No hardcoded default — the server refuses to start if unset.
# Direct calls to /analyze-contract are blocked (403) unless this matches
# the X-Internal-Secret header sent by the x402 gateway.
INTERNAL_SECRET=

# ── Optional overrides ──────────────────────────────────────────────────────
# Ollama endpoint + model used for contract analysis
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_TIMEOUT=180
